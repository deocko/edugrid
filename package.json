{
  "name": "edugrid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "EDUGRID — Una escuela. Todos conectados. Plataforma web de gestión escolar.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "seed": "node scripts/generate-seed.mjs && esbuild scripts/seed-invoice.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/seed-invoice.mjs --log-level=warning && node node_modules/.tmp/seed-invoice.mjs"
  },
  "dependencies": {
    "jspdf": "^3.0.4",
    "jsqr": "1.4.0",
    "lucide-react": "1.70.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.14.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.3.8"
  }
}
